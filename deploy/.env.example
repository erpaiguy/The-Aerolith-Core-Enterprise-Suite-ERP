# Copy to deploy/.env (never commit it). Fill the secrets with:
#   bash deploy/scripts/init-env.sh
# Keep an encrypted offline copy of the finished file: losing CONTROL_PLANE_ENC_KEY means every stored tenant
# credential and licence key copy becomes unreadable (docs/10-deployment.md §10.1).

# --- Database (local Postgres container) ---
POSTGRES_USER=aerolith
POSTGRES_PASSWORD=

# --- Where people reach the app (the tunnel's https address, or http://127.0.0.1:8080 for local testing) ---
PUBLIC_API_URL=http://127.0.0.1:8080
WEBSITE_URL=http://127.0.0.1:8080
# Desktop app origin allowed to call the API.
CORS_ORIGINS=app://aerolith

# --- Secrets (generated) ---
SESSION_SIGNING_KEY=
LICENCE_KEY_PEPPER=
CONTROL_PLANE_ENC_KEY=
ENTITLEMENT_PRIVATE_KEY_PEM=

# --- Email (docs/email.md) ---
EMAIL_TRANSPORT=file
EMAIL_FROM=Aerolith Core <no-reply@your-domain.in>
SUPPORT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- Supabase onboarding (docs/supabase-oauth-setup.md); leave empty until the OAuth app exists ---
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=

# --- Ports on this PC ---
BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
OWNER_PORT=8081
