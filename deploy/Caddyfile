# Two listeners (docs/deployment-docker.md):
#   :8080  public site: browser app + API, owner-console routes refused. A tunnel or proxy points here.
#   :8081  owner console API only. Published on the PC's 127.0.0.1, never reachable from outside.
# Plain HTTP inside the PC: TLS is terminated by whatever sits in front (tunnel, reverse proxy, VM load balancer).
{
	admin off
	auto_https off
}

(security_headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

:8080 {
	encode zstd gzip
	import security_headers
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"

	handle /api/owner* {
		respond "Not found" 404
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}

:8081 {
	import security_headers
	handle /api/owner* {
		reverse_proxy api:3000
	}
	handle /api/auth/mfa/* {
		reverse_proxy api:3000
	}
	handle /api/health {
		reverse_proxy api:3000
	}
	respond "Not found" 404
}
