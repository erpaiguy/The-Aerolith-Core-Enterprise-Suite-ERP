{
  "name": "@aerolith/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Aerolith Core desktop app (Electron shell around the web UI)",
  "productName": "Aerolith Core",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "dist:win": "electron-builder --win --publish never",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "vitest": "^5.0.0"
  }
}
