{
  "name": "@aerolith/api",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=.env --watch dist/main.js",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "migrate:control": "node --env-file-if-exists=.env dist/cli/migrate-control.js",
    "restore:backup": "node dist/cli/restore-backup.js",
    "secrets:generate": "node dist/cli/generate-secrets.js",
    "operator:create": "node --env-file-if-exists=.env dist/cli/create-operator.js",
    "operator:reset": "node --env-file-if-exists=.env dist/cli/reset-operator.js",
    "dev:outbox": "node --env-file-if-exists=.env dist/cli/dev-outbox.js"
  },
  "dependencies": {
    "@aerolith/shared": "workspace:*",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^9.4.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-fastify": "^12.2.0",
    "@node-rs/argon2": "^2.2.2",
    "archiver": "5.3.2",
    "csv-parse": "^7.0.2",
    "exceljs": "4.4.0",
    "fastify": "5.12.7",
    "nodemailer": "^10.2.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.624",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "saxes": "5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.2.0",
    "@swc/core": "^1.16.20",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/smtp-server": "^3.5.13",
    "mailparser": "^3.12.4",
    "smtp-server": "^3.21.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
