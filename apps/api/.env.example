# Copy to apps/api/.env for local development. Generate real values with:
#   pnpm --filter @aerolith/api build && pnpm --filter @aerolith/api secrets:generate
# Without these, development uses throwaway secrets that change on every restart.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Control plane database (owner's Supabase project in production; schema `core`).
CONTROL_DATABASE_URL=postgres://user:password@127.0.0.1:5432/aerolith_control

# Secrets: required in production, never commit real values.
SESSION_SIGNING_KEY=
LICENCE_KEY_PEPPER=
CONTROL_PLANE_ENC_KEY=
ENTITLEMENT_PRIVATE_KEY_PEM=

# Licensing rules (defaults shown).
TRIAL_DAYS=120
TRIAL_GRACE_DAYS=7
MIN_SHORTEN_NOTICE_DAYS=14
ENTITLEMENT_TTL_HOURS=168
DEVICES_PER_SEAT=2

# Tenant databases.
PUBLIC_API_URL=http://127.0.0.1:3000
WEBSITE_URL=http://localhost:5173
TENANT_DB_REGION=ap-south-1
MAX_TENANT_POOLS=50
# Local stand-in provider: a Postgres superuser URL. Leave empty to disable.
LOCAL_PG_ADMIN_URL=
# Supabase OAuth app registered in the owner's Supabase organisation. Leave empty until registered.
SUPABASE_API_URL=https://api.supabase.com
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=

# Security.
# Multiplies all rate limits (keep 1 in production).
RATE_LIMIT_SCALE=1
# true only when a proxy/tunnel in front of the API sets X-Forwarded-For.
TRUST_PROXY=false
# Origins allowed to call the API cross-origin. The desktop app loads the UI from app://aerolith.
CORS_ORIGINS=app://aerolith

# Email (docs/email.md). Production must set EMAIL_TRANSPORT (smtp or disabled).
EMAIL_TRANSPORT=file
EMAIL_FILE_DIR=.mail-outbox
EMAIL_FROM=Aerolith Core <no-reply@your-domain.in>
EMAIL_REPLY_TO=
SUPPORT_EMAIL=
EMAIL_MAX_PER_HOUR=60
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_REQUIRE_TLS=true
