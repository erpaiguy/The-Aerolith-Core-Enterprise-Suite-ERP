# Copy to apps/api/.env for local development. Generate real values with:
#   pnpm --filter @aerolith/api build && pnpm --filter @aerolith/api secrets:generate
# Without these, development uses throwaway secrets that change on every restart.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Control plane database (owner's Supabase project in production; schema `core`).
CONTROL_DATABASE_URL=postgres://user:password@127.0.0.1:5432/aerolith_control

# Secrets: required in production, never commit real values.
OWNER_API_TOKEN=
LICENCE_KEY_PEPPER=
CONTROL_PLANE_ENC_KEY=
ENTITLEMENT_PRIVATE_KEY_PEM=

# Licensing rules (defaults shown).
TRIAL_DAYS=120
TRIAL_GRACE_DAYS=7
MIN_SHORTEN_NOTICE_DAYS=14
ENTITLEMENT_TTL_HOURS=168
DEVICES_PER_SEAT=2
